features_importance = pd.Series(poisonous_features_prob, index=X_encoded.columns).sort_values(ascending=False)

plt.figure(figsize=(10, 6))
# Future warning ko fix karne ke liye hue aur legend=False add kiya gaya hai
sns.barplot(
    x=features_importance.head(10).values, 
    y=features_importance.head(10).index, 
    hue=features_importance.head(10).index,
    palette='flare',
    legend=False
)
