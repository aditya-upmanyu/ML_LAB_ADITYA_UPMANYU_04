import pandas as pd
from sklearn.preprocessing import LabelEncoder
from sklearn.tree import DecisionTreeClassifier
from sklearn import tree
import matplotlib.pyplot as plt

# Step 1: Dataset ko load karein
df = pd.read_csv('/content/play_tennis.csv')

print("Original Dataset:")
print(df.head())

# Agar dataset mein 'Day' column hai, toh use hata dein
if 'Day' in df.columns:
    df = df.drop('Day', axis=1)

# Step 2: Text data ko numerical data mein convert karein (Label Encoding)
# Kyunki hum column values change kar rahe hain, isliye alag LabelEncoder instances use karenge taaki correct class_names map ho sakein
encoders = {}
for column in df.columns:
    le = LabelEncoder()
    df[column] = le.fit_transform(df[column])
    encoders[column] = le

# Step 3: Features (X) aur Target (y) ko alag karein
X = df.iloc[:, :-1]  # Features
y = df.iloc[:, -1]   # Target

# Step 4: Decision Tree Classifier banayein aur train karein
clf = DecisionTreeClassifier(criterion='entropy', random_state=42)
clf.fit(X, y)

print("\nModel successfully train ho gaya hai!")

# Step 5: Decision Tree ko visualize karein
# Target column ke actual class names ko extract karein
target_classes = [str(c) for c in encoders[df.columns[-1]].classes_]

plt.figure(figsize=(12, 8))
tree.plot_tree(clf, feature_names=X.columns, class_names=target_classes, filled=True, rounded=True)
plt.title("Decision Tree for Play Tennis Dataset")
plt.show()
