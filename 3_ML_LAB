import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression

df = pd.read_csv('/content/california_housing_train.csv')


# =========================================================
# 1. ORIGINAL DATA - Prediction
# =========================================================

# X = Feature/Input
# Longitude ko input feature bana rahe hain
X = df[['longitude']]

# y = Target/Output
# Latitude ko target bana rahe hain
y = df['latitude']

# Linear Regression model create karna
model = LinearRegression()

# Longitude aur Latitude ka relationship model ko sikhana
model.fit(X, y)

# Original data ki prediction
prediction = model.predict(X)


# =========================================================
# 2. OUTLIERS FILTER KARNA
# =========================================================

# 99th percentile limits find karna
x_limit = df['longitude'].quantile(0.99)
y_limit = df['latitude'].quantile(0.99)

# Sirf woh rows rakhna jahan longitude aur latitude
# dono apni 99th percentile limit se kam hain
df_clean = df[
    (df['longitude'] < x_limit) &
    (df['latitude'] < y_limit)
]

# Clean data se X aur y banana
x_clean = df_clean[['longitude']]
y_clean = df_clean['latitude']


# =========================================================
# 3. CLEAN DATA PAR NAYA MODEL
# =========================================================

# Clean data ke liye Linear Regression model
model_clean = LinearRegression()

# Clean data par model ko train karna
model_clean.fit(x_clean, y_clean)

# Clean data ki prediction
prediction_clean = model_clean.predict(x_clean)


# =========================================================
# 4. SUBPLOT
# =========================================================

# 1 row aur 2 columns mein 2 graphs banana
plt.figure(figsize=(12, 5))


# ---------------- ORIGINAL DATA ----------------

plt.subplot(1, 2, 1)

# Original actual data
plt.scatter(X, y, color='blue', alpha=0.3)

# Original data ki regression line
plt.plot(X, prediction, color='red')

plt.xlabel('Longitude')
plt.ylabel('Latitude')
plt.title('Original Data')


# ---------------- CLEAN DATA ----------------

plt.subplot(1, 2, 2)

# Outliers filter karne ke baad actual data
plt.scatter(x_clean, y_clean, color='blue', alpha=0.3)

# Clean data ki regression line
plt.plot(x_clean, prediction_clean, color='red')

plt.xlabel('Longitude')
plt.ylabel('Latitude')
plt.title('After Removing Outliers')


# Dono graphs ko properly adjust karna
plt.tight_layout()

# Graph show karna
plt.show()
