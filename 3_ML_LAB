import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression


# ---------------------------------------------------------
# STEP 1: Load the dataset
# ---------------------------------------------------------

# CSV file ko read karke DataFrame mein store kar rahe hain
df = pd.read_csv('/content/california_housing_train.csv')


# ---------------------------------------------------------
# STEP 2: Select Feature (X) and Target (y)
# ---------------------------------------------------------

# X = Feature/Input
# Hum housing_median_age ko input feature bana rahe hain
X = df[['housing_median_age']]

# y = Target/Output
# Hum total_rooms ko predict karna chahte hain
y = df['total_rooms']


# ---------------------------------------------------------
# STEP 3: Create Linear Regression Model
# ---------------------------------------------------------

# Linear Regression ka model create kar rahe hain
model = LinearRegression()

# Model ko X aur y ka relationship sikhate hain
# Yaani housing_median_age ke basis par total_rooms predict karna
# seekh raha hai
model.fit(X, y)


# ---------------------------------------------------------
# STEP 4: Find Outliers using 99th Percentile
# ---------------------------------------------------------

# Outlier:
# Outlier ek aisi value hoti hai jo baaki data ke comparison
# mein bahut zyada extreme hoti hai.
#
# Outliers ki wajah se graph ka scale distort ho sakta hai.
#
# 99th percentile:
# quantile(0.99) data ki 99th percentile value find karta hai.
# Iska matlab approximately top 1% extreme values is limit
# se upar hongi.
#
# Original data delete nahi hota.
# Abhi hum sirf X aur Y ki limits calculate kar rahe hain.

x_limit = df['housing_median_age'].quantile(0.99)
y_limit = df['total_rooms'].quantile(0.99)


# ---------------------------------------------------------
# STEP 5: Plot the Original Data
# ---------------------------------------------------------

# Actual data points ko blue dots ke form mein show kar rahe hain
plt.scatter(X, y, color='blue')

# Linear Regression ki predicted values ke basis par
# best-fit/prediction line draw kar rahe hain
plt.plot(X, model.predict(X), color='red')


# ---------------------------------------------------------
# STEP 6: Set Graph Limits
# ---------------------------------------------------------

# X-axis ki maximum limit 99th percentile tak set kar rahe hain
# Isse extreme X values graph mein visible nahi hongi
plt.xlim(0, x_limit)

# Y-axis ki maximum limit 99th percentile tak set kar rahe hain
# Isse extreme Y values graph mein visible nahi hongi
plt.ylim(0, y_limit)


# Graph ke X-axis ka naam
plt.xlabel('Housing Median Age')

# Graph ke Y-axis ka naam
plt.ylabel('Total Rooms')

# Graph ka title
plt.title('Housing Median Age vs Total Rooms')

# Graph ko display karna
plt.show()


# ---------------------------------------------------------
# STEP 7: Correlation
# ---------------------------------------------------------

# Correlation:
# Correlation do variables/features ke beech relationship
# ko measure karta hai.
#
# Ye batata hai ki ek variable ke change hone par doosra
# variable kis direction mein aur kitna related hai.
#
# Correlation ki value -1 se +1 ke beech hoti hai:
#
# +1 -> Perfect positive correlation
#  0 -> No linear correlation
# -1 -> Perfect negative correlation
#
# Positive correlation:
# Ek variable badhta hai to doosra bhi generally badhta hai.
#
# Negative correlation:
# Ek variable badhta hai to doosra generally decrease hota hai.
#
# Correlation 0 ke close ho to linear relationship weak hota hai.
#
# Feature ke context mein:
# Feature (X) aur Target (y) ke beech correlation dekhkar
# hum samajh sakte hain ki feature target ke saath kitna related hai.
#
# Important:
# Correlation relationship batata hai, lekin ye prove nahi karta
# ki ek variable doosre variable ka cause hai.


# ---------------------------------------------------------
# STEP 8: Remove/Filter Outliers
# ---------------------------------------------------------

# df_clean mein sirf woh rows rakhenge jahan:
#
# 1. housing_median_age < x_limit
# AND
# 2. total_rooms < y_limit
#
# '&' ka matlab hai dono conditions TRUE honi chahiye.
#
# Isse 99th percentile se upar ki extreme values filter ho jayengi.
# Original df change nahi hoga; filtered data df_clean mein milega.

df_clean = df[
    (df['housing_median_age'] < x_limit) &
    (df['total_rooms'] < y_limit)
]


# df_clean mein filtered data check kar sakte hain
